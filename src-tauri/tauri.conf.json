{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "TablePro",
  "version": "0.7.1",
  "identifier": "app.tablepro.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "features": ["devtools"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TablePro",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tablepro"]
      }
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["sqlite", "sqlite3", "db"],
        "description": "SQLite Database",
        "mimeType": "application/x-sqlite3"
      },
      {
        "ext": ["tablepro"],
        "description": "TablePro Connection Export",
        "mimeType": "application/x-tablepro"
      }
    ],
    "createUpdaterArtifacts": false,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "driver-capabilities/*.capabilities.json": "driver-capabilities/"
    },
    "copyright": "Copyright 2026 TablePro",
    "category": "DeveloperTool",
    "shortDescription": "Database client for PostgreSQL, MySQL, SQL Server",
    "longDescription": "TablePro is a modern database management tool for Windows supporting PostgreSQL, MySQL, and SQL Server with a plugin-based driver architecture.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
