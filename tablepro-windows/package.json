{
    "name": "tablepro-windows",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:drivers": "cargo build --manifest-path src-tauri/driver-postgres/Cargo.toml && cargo build --manifest-path src-tauri/driver-mysql/Cargo.toml && cargo build --manifest-path src-tauri/driver-mssql/Cargo.toml && cargo build --manifest-path src-tauri/driver-sqlite/Cargo.toml",
        "preview": "vite preview",
        "tauri": "tauri",
        "dev:tauri": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
        "dev:tauri:cli": "tauri dev --no-watch",
        "build:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-debug.ps1",
        "build:release": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1",
        "build:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Target portable",
        "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Target installer",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.1",
        "@codemirror/commands": "^6.10.3",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/language": "^6.12.2",
        "@codemirror/lint": "^6.9.5",
        "@codemirror/search": "^6.6.0",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.40.0",
        "@replit/codemirror-vim": "^6.3.0",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.22",
        "@tauri-apps/api": "^2.0.0",
        "@tauri-apps/plugin-dialog": "^2.6.0",
        "@tauri-apps/plugin-shell": "^2.0.0",
        "@types/dompurify": "^3.0.5",
        "cmdk": "^1.1.1",
        "dompurify": "^3.3.3",
        "lucide-react": "^0.460.0",
        "marked": "^17.0.5",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "sonner": "^2.0.7",
        "sql-formatter": "^15.7.2",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "@vitest/coverage-v8": "^3.2.4",
        "autoprefixer": "^10.4.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "postcss": "^8.4.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.57.2",
        "vite": "^6.0.0",
        "vitest": "^3.2.4"
    }
}
